<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.temple.donation">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TempleDonationManager">

        <!-- Login selection screen -->
        <activity
            android:name=".activities.LoginSelectionActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Admin login screen -->
        <activity
            android:name=".activities.AdminLoginActivity"
            android:exported="false" />

        <!-- Devotee login screen -->
        <activity
            android:name=".activities.DevoteeLoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.DevoteeDashboardActivity"
            android:exported="false" />
        <!-- Admin dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- Devotee management -->
        <activity
            android:name=".activities.DevoteeActivity"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/title_devotees" />

        <!-- Monthly donation -->
        <activity
            android:name=".activities.DonationActivity"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/title_donations" />

        <!-- Expenses -->
        <activity
            android:name=".activities.ExpenseActivity"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/title_expenses" />

        <!-- Monthly reports and PDF export -->
        <activity
            android:name=".activities.ReportActivity"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/title_report" />

        <!-- Secure PDF sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.temple.donation.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

    </application>

</manifest>