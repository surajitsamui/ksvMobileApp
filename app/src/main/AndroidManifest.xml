<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.temple.donation">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TempleDonationManager">

        <!-- Main Dashboard -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Devotee Management -->
        <activity
            android:name=".activities.DevoteeActivity"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/title_devotees" />

        <!-- Monthly Donation -->
        <activity
            android:name=".activities.DonationActivity"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/title_donations" />

        <!-- Expenses -->
        <activity
            android:name=".activities.ExpenseActivity"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/title_expenses" />

        <!-- Monthly Report & PDF Export -->
        <activity
            android:name=".activities.ReportActivity"
            android:parentActivityName=".activities.MainActivity"
            android:label="@string/title_report" />

        <!-- FileProvider for Sharing Generated PDFs securely -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.temple.donation.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
